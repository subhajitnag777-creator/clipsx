# ==========================================
# WEBSITE CONFIGURATION
# ==========================================
NODE_ENV=production
PORT=8765
HOST=0.0.0.0
APP_URL=https://yourdomain.com
PUBLIC_URL=https://yourdomain.com
CLIPSX_ACCOUNTS=1
# CLIPSX_DATA=./data

# ==========================================
# CLOUDFLARE CONFIGURATION
# ==========================================
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_CLIENT_IP_HEADER=CF-Connecting-IP

# ==========================================
# CLOUDFLARE R2 OBJECT STORAGE (ZERO-EGRESS)
# ==========================================
# Set R2_ENABLED=true to store and stream all clips & videos from Cloudflare R2
R2_ENABLED=false
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=clipsx-media
# Optional: Custom domain or public R2 URL (e.g. https://media.yourdomain.com or https://pub-xxx.r2.dev)
R2_PUBLIC_URL=
R2_REGION=auto

# ==========================================
# CLOUDFLARE TUNNEL (HOSTING & SECURE HTTPS)
# ==========================================
# Run cloudflared to expose Clips X to the internet with automatic SSL, DDoS protection & Turnstile
# Get your token from Cloudflare Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# ==========================================
# CLOUDFLARE TURNSTILE (BOT PROTECTION)
# ==========================================
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_ENABLED=false

# ==========================================
# GOOGLE OAUTH AUTHENTICATION
# ==========================================
# Used for "Continue with Google" sign-in and YouTube Shorts publishing
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/auth/google/callback

# ==========================================
# JWT & SESSION SECURITY
# ==========================================
JWT_SECRET=generate_a_random_64_character_hex_secret_here
SESSION_SECRET=generate_a_random_64_character_hex_secret_here
SESSION_COOKIE_SECURE=true
SESSION_DAYS=30

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Leave empty for SQLite in data folder, or use postgresql+psycopg://user:pass@host/db
DATABASE_URL=

# ==========================================
# RATE LIMITING CONFIGURATION
# ==========================================
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=5
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_MAX=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15

# ==========================================
# ADMIN & OWNER CONFIGURATION
# ==========================================
ADMIN_EMAIL=admin@yourdomain.com
CLIPSX_OWNER_EMAIL=admin@yourdomain.com

# ==========================================
# EMAIL / SMTP CONFIGURATION
# ==========================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_smtp_password
SMTP_FROM=Clips X <hello@yourdomain.com>
VERIFY_EMAIL=1

# ==========================================
# CONNECTED APPS & SOCIAL POSTING (OPTIONAL)
# ==========================================
# Instagram: Users can connect directly in Settings > Connected apps by pasting an Instagram
# Access Token, OR server owners can register a Meta App for 1-click OAuth below:
CLIPSX_IG_APP_ID=
CLIPSX_IG_APP_SECRET=
CLIPSX_TIKTOK_CLIENT_KEY=
CLIPSX_TIKTOK_CLIENT_SECRET=

# ==========================================
# AI SERVICE PROVIDER (BRING YOUR OWN KEY)
# ==========================================
# Empty by default so each user configures their own AI keys independently in Settings.
CLIPSX_AI_PROVIDER=
CLIPSX_AI_MODELS=
CLIPSX_AI_KEY=
CLIPSX_AI_BASE_URL=
